[
    {
        "doctype": "Notification",
        "name": "PE Pending Approval",
        "module": "Employee Portal",
        "document_type": "Payment Entry",
        "enabled": 1,
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Pending Approval'",
        "channel": "System Notification",
        "subject": "PE {{ doc.name }} needs approval",
        "message": "Payment Entry {{ doc.name }} from {{ doc.get_formatted('owner') }} is waiting for your approval.",
        "recipients": [
            {
                "role": "Accounts Manager"
            }
        ]
    }
]