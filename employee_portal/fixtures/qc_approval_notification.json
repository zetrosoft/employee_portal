[
    {
        "doctype": "Notification",
        "name": "QC Pending Approval",
        "module": "Employee Portal",
        "document_type": "Quality Inspection",
        "enabled": 1,
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Pending Approval (Manager)'",
        "channel": "System Notification",
        "subject": "QC {{ doc.name }} menunggu persetujuan Anda",
        "message": "Inspeksi Kualitas {{ doc.name }} dari {{ doc.owner_name }} menunggu persetujuan Anda.",
        "recipients": [
            {
                "receiver_by_role": "Quality Manager"
            }
        ]
    },
    {
        "doctype": "Notification",
        "name": "QC Approved",
        "module": "Employee Portal",
        "document_type": "Quality Inspection",
        "enabled": 1,
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Submitted'",
        "channel": "System Notification",
        "subject": "QC {{ doc.name }} telah disetujui",
        "message": "Inspeksi Kualitas {{ doc.name }} Anda telah disetujui.",
        "recipients": [
            {
                "receiver_by_document_field": "owner"
            }
        ]
    },
    {
        "doctype": "Notification",
        "name": "QC Rejected",
        "module": "Employee Portal",
        "document_type": "Quality Inspection",
        "enabled": 1,
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Cancelled'",
        "channel": "System Notification",
        "subject": "QC {{ doc.name }} telah ditolak",
        "message": "Inspeksi Kualitas {{ doc.name }} Anda telah ditolak. Mohon periksa kembali.",
        "recipients": [
            {
                "receiver_by_document_field": "owner"
            }
        ]
    }
]
