[
    {
        "doctype": "Notification",
        "name": "WO Pending PM Approval",
        "enabled": 1,
        "document_type": "Work Order",
        "channel": "System Notification",
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Pending PM Approval'",
        "subject": "Work Order {{ doc.name }} membutuhkan persetujuan Anda",
        "message": "Work Order {{ doc.name }} dari {{ doc.owner }} menunggu persetujuan Anda.",
        "recipients": [
            {"receiver_by_role": "Production Manager"}
        ]
    },
    {
        "doctype": "Notification",
        "name": "WO Submitted to Requester",
        "enabled": 1,
        "document_type": "Work Order",
        "channel": "System Notification",
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Submitted'",
        "subject": "Work Order {{ doc.name }} telah disubmit",
        "message": "Your Work Order {{ doc.name }} telah disetujui dan disubmit.",
        "recipients": [
            {"receiver_by_document_field": "owner"}
        ]
    },
    {
        "doctype": "Notification",
        "name": "WO Rejected to Requester",
        "enabled": 1,
        "document_type": "Work Order",
        "channel": "System Notification",
        "event": "Value Change",
        "value_changed": "workflow_state",
        "condition": "doc.workflow_state == 'Rejected'",
        "subject": "Work Order {{ doc.name }} telah ditolak",
        "message": "Work Order {{ doc.name }} Anda telah ditolak.",
        "recipients": [
            {"receiver_by_document_field": "owner"}
        ]
    }
]