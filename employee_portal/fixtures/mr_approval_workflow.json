[
    {
        "name": "Material Request Approval",
        "workflow_name": "Material Request Approval",
        "doctype": "Workflow",
        "document_type": "Material Request",
        "workflow_state_field": "workflow_state",
        "is_active": 1,
        "override_status": 1,
        "send_email_alert": 0,
        "docstatus": 0,
        "states": [
            {
                "state": "Draft",
                "doc_status": "0",
                "allow_edit": "Production User"
            },
            {
                "state": "Draft",
                "doc_status": "0",
                "allow_edit": "Stock User"
            },
            {
                "state": "Pending PM Approval",
                "doc_status": "0",
                "allow_edit": "Production Manager"
            },
            {
                "state": "Pending Stock User Review",
                "doc_status": "0",
                "allow_edit": "Stock User"
            },
            {
                "state": "Pending SM Approval",
                "doc_status": "0",
                "allow_edit": "Stock Manager"
            },
            {
                "state": "Submitted",
                "doc_status": "1",
                "allow_edit": "Administrator"
            },
            {
                "state": "Rejected",
                "doc_status": "0",
                "allow_edit": "Production User"
            },
            {
                "state": "Rejected",
                "doc_status": "0",
                "allow_edit": "Stock User"
            }
        ],
        "transitions": [
            {
                "state": "Draft",
                "action": "Approval PM",
                "next_state": "Pending PM Approval",
                "allowed": "Production User",
                "condition": "doc.request_type == 'Produksi'",
                "allow_self_approval": 1
            },
            {
                "state": "Draft",
                "action": "Approval SM",
                "next_state": "Pending SM Approval",
                "allowed": "Stock User",
                "condition": "doc.request_type == 'Gudang'",
                "allow_self_approval": 1
            },
            {
                "state": "Pending PM Approval",
                "action": "Approve",
                "next_state": "Pending Stock User Review",
                "allowed": "Production Manager"
            },
            {
                "state": "Pending PM Approval",
                "action": "Reject",
                "next_state": "Rejected",
                "allowed": "Production Manager"
            },
            {
                "state": "Pending Stock User Review",
                "action": "Forward to Manager",
                "next_state": "Pending SM Approval",
                "allowed": "Stock User"
            },
            {
                "state": "Pending Stock User Review",
                "action": "Reject",
                "next_state": "Rejected",
                "allowed": "Stock User"
            },
            {
                "state": "Pending SM Approval",
                "action": "Approve and Submit",
                "next_state": "Submitted",
                "allowed": "Stock Manager",
                "submit_document": 1
            },
            {
                "state": "Pending SM Approval",
                "action": "Reject",
                "next_state": "Rejected",
                "allowed": "Stock Manager"
            }
        ]
    }
]