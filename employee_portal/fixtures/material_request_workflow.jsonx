[
    {
        "name": "Material Request Approval",
        "workflow_name": "Material Request Approval",
        "doctype": "Workflow",
        "document_type": "Material Request",
        "workflow_state_field": "workflow_state",
        "is_active": 1,
        "override_status": 1,
        "send_email_alert": 1,
        "docstatus": 0,
        "owner": "Administrator",
        "creation": "2025-11-03 10:00:00.000000",
        "modified": "2025-11-05 10:00:00.000000",
        "modified_by": "Administrator",
        "allow_self_approval": 0,
        "states": [
            {
                "state": "Draft",
                "doc_status": "0",
                "allow_edit": "Stock User, Production User"
            },
            {
                "state": "Pending Stock Approval",
                "doc_status": "0",
                "allow_edit": "Stock Manager"
            },
            {
                "state": "Pending Production Approval",
                "doc_status": "0",
                "allow_edit": "Production Manager"
            },
            {
                "state": "Approved",
                "doc_status": "1",
                "allow_edit": "Stock User, Production User"
            },
            {
                "state": "Rejected",
                "doc_status": "0",
                "allow_edit": "Stock User, Production User"
            }
        ],
        "transitions": [
            {
                "state": "Draft",
                "action": "Submit",
                "next_state": "Pending Stock Approval",
                "allowed": "Stock User",
                "condition": "doc.request_type == 'Gudang'"
            },
            {
                "state": "Draft",
                "action": "Submit",
                "next_state": "Pending Production Approval",
                "allowed": "Production User",
                "condition": "doc.request_type == 'Produksi'"
            },
            {
                "state": "Pending Stock Approval",
                "action": "Approve",
                "next_state": "Approved",
                "allowed": "Stock Manager",
                "submit_document": 1
            },
            {
                "state": "Pending Stock Approval",
                "action": "Reject",
                "next_state": "Rejected",
                "allowed": "Stock Manager"
            },
            {
                "state": "Pending Production Approval",
                "action": "Approve",
                "next_state": "Approved",
                "allowed": "Production Manager",
                "submit_document": 1
            },
            {
                "state": "Pending Production Approval",
                "action": "Reject",
                "next_state": "Rejected",
                "allowed": "Production Manager"
            }
        ]
    }
]
